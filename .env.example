# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://finance_health:finance_health@localhost:55432/finance_health?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEBHOOK_SHARED_SECRET=replace-with-long-random-secret
SYNC_WORKER_INTERVAL_MS=1000

# Pluggy - backend only. Never expose these in Expo/public env vars.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Mobile: configure separadamente em apps/mobile/.env.local.
CORS_ORIGINS=http://localhost:8081
